{
  "name": "sso-emulator-ranger-integration",
  "version": "0.1.0",
  "description": "Custom OAuth2 Authorization Code (+PKCE) SSO server modelled on a bank SSO, with Apache Ranger Knox-SSO integration",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "genkeys": "node src/lib/generateKeys.js",
    "seed": "node src/db/seed.js",
    "create-user": "node scripts/create-user.js",
    "ranger-cert": "node src/lib/printRangerCertificate.js",
    "check": "for f in $(find src scripts -name '*.js'); do node --check $f || exit 1; done",
    "test": "bash test/smoke.sh"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.4.5",
    "uuid": "^9.0.1",
    "bcryptjs": "^2.4.3"
  },
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20"
  }
}
